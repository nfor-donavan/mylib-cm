PORT=4000
# Same Atlas cluster/user as your other project, but pointed at a separate
# database ("library_saas") so this app's data never mixes with EduCore's.
# Replace <password> with your real Atlas user password.
MONGODB_URI=mongodb+srv://donavannfor_db_user:<password>@hms.qgz5qvy.mongodb.net/library_saas?appName=MyLibCM
JWT_SECRET=replace-with-a-long-random-string

# Comma-separated list of allowed frontend origins (no trailing slash)
FRONTEND_URLS=https://your-librarian-panel.onrender.com,https://your-student-portal.onrender.com

# "console" logs SMS to the terminal instead of sending — good for local dev
# Real options: "bulksms", "twilio", or "webhook" (points at your own SMS microservice)
SMS_PROVIDER=console
BULKSMS_USERNAME=
BULKSMS_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_WEBHOOK_URL=

# XAF charged per day a loan is overdue (accrued daily by the 8am cron sweep)
FINE_PER_DAY_XAF=50
